   "source": [
    "# Ask the user for a number and convert it to an integer\n",
    "number = int(input(\"Enter an integer: \"))\n",
    "\n",
    "# Check the conditions\n",
    "if number > 0:\n",
    "    print(\"The number is Positive.\")\n",
    "elif number < 0:\n",
    "    print(\"The number is Negative.\")\n",
    "else:\n",
    "    print(\"The number is Zero.\")"
   ]
  }
